# LLM Provider
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional online enhancement deadlines; deterministic fallbacks take over.
TUTOR_MODEL_BUDGET_SECONDS=15
LEARNING_TASK_PLAN_MODEL_BUDGET_SECONDS=12
MICRO_LEARNING_ARTIFACT_MODEL_BUDGET_SECONDS=18

# Learning-task conversion uses one fixed, published Xingchen workflow.
# Put XFYUN_APP_ID / XFYUN_API_KEY / XFYUN_API_SECRET / XFYUN_FLOW_ID in
# backend/.private/learning_task_conversion.xfyun.env. Never commit that file.
# LEARNING_TASK_XFYUN_CREDENTIALS_PATH=
LEARNING_TASK_CONVERSION_BASE_URL=https://82.156.199.145
LEARNING_TASK_CONVERSION_TIMEOUT_SECONDS=30

# LearnFlow
DATABASE_URL=sqlite+aiosqlite:///./learnflow.db
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
LOG_LEVEL=info
# true 时仅用于隔离的离线比赛演示库；正常开发保持 false
COMPETITION_DEMO_MODE=false
# Tauri sidecar injects both values for each launch. Never enable this on a
# remotely reachable server or commit a real token.
DESKTOP_MODE=false

# External .lfplugin processes are disabled unless the operator explicitly
# accepts the disclosed, non-isolated trusted-local-process boundary.
PLUGIN_EXECUTION_MODE=disabled
PLUGIN_ALLOW_UNSIGNED_DEV=false
PLUGIN_ARTIFACT_DIR=data/plugin-artifacts
PLUGIN_RUNNER_TIMEOUT_SECONDS=180
PLUGIN_RUNNER_MAX_MESSAGE_BYTES=262144
PLUGIN_RUNNER_MAX_OUTPUT_BYTES=1048576
PLUGIN_RUNNER_MAX_HOST_CALLS=32
DESKTOP_TOKEN=
# Keep the Fact -> Module -> Claim projection live. Set false only for
# diagnostics that intentionally need to inspect an unconsumed queue.
MEMORY_AUTO_SYNTHESIS_ENABLED=true
# Optional: raises the GitHub API rate limit for proposal resource search
# GITHUB_TOKEN=github_pat_...
# GITHUB_RESOURCE_SEARCH_ENABLED=true
# DEV_TEST_LOGIN_ENABLED=true
# AUTH_COOKIE_SECURE=false

# Production account security. Generate AUTH_API_KEY_KEK from exactly 32
# random bytes encoded with URL-safe base64. The bridge token is an independent
# 32+ character server-only secret shared with the Vite server process; neither
# value is returned to browser code or stored in the database.
# AUTH_API_KEY_KEK=
# AUTH_API_KEY_KEK_VERSION=1
# AUTH_RUNTIME_BRIDGE_TOKEN=

# Embedding
# EMBEDDING_BACKEND=local   # local (gte-small, default) | api (OpenAI-compatible)
# EMBEDDING_MODEL=text-embedding-ada-002

# Embedding (optional — separate from LLM config)
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Vision (image understanding) — Moonshot
# VISION_API_KEY=sk-...        # 留空则复用 LLM_API_KEY（若同 provider）
# VISION_BASE_URL=https://api.moonshot.cn/v1
# VISION_MODEL=kimi-k2.7-code-highspeed  # 已实测支持视觉且最快

# Reference-source cache (images/markdown persisted from GitHub/URL sources).
# This is not a project workspace.
# SOURCE_CACHE_DIR=data/repo-files
# Uploaded reference originals (also not a project workspace).
# SOURCE_UPLOADS_DIR=data/source-uploads
