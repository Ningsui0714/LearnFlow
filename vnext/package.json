{
  "name": "learnflow-vnext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test:search": "node --experimental-strip-types --test server/computer-knowledge-search.test.ts",
    "test:learning": "node --experimental-strip-types --test server/learning-task.test.ts server/agent-runtime.test.ts",
    "test:planning": "node --experimental-strip-types --test server/planning.test.ts",
    "test:profile": "node --experimental-strip-types --test server/five-kernel-profile.test.ts server/profile-presentation.test.ts",
    "test:path": "node --experimental-strip-types --test server/learning-path-graph.test.ts",
    "test:formal": "node --experimental-strip-types --test server/formal-runtime.test.ts server/project-sidebar.test.ts",
    "test": "npm run test:search && npm run test:learning && npm run test:planning && npm run test:profile && npm run test:path && npm run test:formal"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
