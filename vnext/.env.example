# Copy this file to .env.local and keep the real value on this machine only.
LEARNFLOW_API_KEY=

# Optional search providers. Without these, LearnFlow uses the public Jina
# search endpoint plus zero-key knowledge adapters such as Wikipedia,
# Stack Exchange, GitHub and arXiv. Exa takes priority over Tavily when set.
JINA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
