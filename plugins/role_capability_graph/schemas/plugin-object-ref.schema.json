{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learnflow.plugin-object-ref.v1",
  "type": "object",
  "required": ["protocol", "plugin_id", "instance_id", "snapshot_id", "snapshot_root_hash", "object_type", "object_id", "schema_version", "content_hash"],
  "properties": {
    "protocol": {"const": "learnflow.plugin-object-ref.v1"},
    "plugin_id": {"const": "role_capability_graph"},
    "instance_id": {"type": "integer"},
    "snapshot_id": {"type": "integer"},
    "snapshot_root_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "object_type": {"type": "string"},
    "object_id": {"type": "string"},
    "schema_version": {"const": "role-capability.object.v1"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
