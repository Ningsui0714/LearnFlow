{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-capability.object.v1",
  "type": "object",
  "required": ["id", "type", "label"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "type": {
      "enum": ["role", "task", "capability", "knowledge_skill", "claim", "semantic_edge", "scenario", "process_event", "actor", "work_object", "artifact", "risk", "bridge"]
    },
    "label": {"type": "string"},
    "summary": {"type": "string"},
    "lifecycle": {"enum": ["candidate", "accepted", "deprecated", "active"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
