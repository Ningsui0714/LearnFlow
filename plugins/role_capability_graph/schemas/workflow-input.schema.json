{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-capability.workflow-input.v1",
  "type": "object",
  "properties": {
    "role_title": {"type": "string", "minLength": 2, "maxLength": 255},
    "role_summary": {"type": "string", "maxLength": 1200},
    "source_ids": {"type": "array", "items": {"type": "integer"}, "maxItems": 20},
    "task_seeds": {"type": "array", "items": {"type": "string", "maxLength": 500}, "maxItems": 20},
    "snapshot_id": {"type": "integer"},
    "query": {"type": "string", "maxLength": 1000},
    "objective": {"type": "string", "maxLength": 1000},
    "target_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
    "object_type": {"type": "string", "enum": ["task", "capability", "knowledge_skill"]},
    "label": {"type": "string", "maxLength": 100},
    "summary": {"type": "string", "maxLength": 500},
    "parent_id": {"type": "string", "maxLength": 180},
    "evidence_refs": {"type": "array", "items": {"type": "string", "maxLength": 180}, "maxItems": 20},
    "operations": {"type": "array", "items": {"type": "object"}, "maxItems": 24}
  },
  "additionalProperties": false
}
