{
  "protocol": "learnflow.plugin-package.v1",
  "plugin_id": "role_capability_graph",
  "version": "1.0.0",
  "name": "岗位能力图谱",
  "description": "从项目来源形成可解释、可迭代、版本固定的岗位任务—能力—知识图谱。",
  "host_compatibility": {
    "learnflow": ">=0.1.0 <1.0.0",
    "plugin_host": "learnflow.plugin-host.v1"
  },
  "owner": "learning_design_agent",
  "scope": "project",
  "schema_version": "role-capability.object.v1",
  "kernel_allow_list": [],
  "object_types": [
    "role",
    "task",
    "capability",
    "knowledge_skill",
    "claim",
    "semantic_edge",
    "scenario",
    "process_event",
    "actor",
    "work_object",
    "artifact",
    "risk",
    "bridge"
  ],
  "host_ports": [
    "project.read.v1",
    "source.read.v1",
    "knowledge_baseline.read.v1",
    "model.generate_structured.v1",
    "event.record.v1"
  ],
  "workflows": [
    {
      "id": "generate",
      "mode": "write_snapshot",
      "description": "从固定来源版本和显式任务种子生成候选岗位快照。",
      "host_ports": ["project.read.v1", "source.read.v1"],
      "input_schema": "schemas/workflow-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    },
    {
      "id": "explain",
      "mode": "read",
      "description": "固定确切快照后做有界检索、关系遍历和证据解释。",
      "host_ports": [],
      "input_schema": "schemas/workflow-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    },
    {
      "id": "iterate",
      "mode": "write_snapshot",
      "description": "基于 expected snapshot 形成补丁，验证后提交后继快照。",
      "host_ports": [],
      "input_schema": "schemas/workflow-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    },
    {
      "id": "validate",
      "mode": "read",
      "description": "检查结构、引用、证据闭包、语义关系和过程桥接。",
      "host_ports": [],
      "input_schema": "schemas/workflow-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    },
    {
      "id": "upgrade",
      "mode": "migration",
      "description": "验证旧快照与新 release 的兼容性并生成迁移候选。",
      "host_ports": [],
      "input_schema": "schemas/workflow-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    }
  ],
  "tools": [
    {
      "id": "read_graph",
      "mode": "read",
      "description": "读取当前或指定固定快照中的岗位对象和关系。",
      "workflow": "validate",
      "input_schema": "schemas/tool-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    },
    {
      "id": "explain",
      "mode": "read",
      "description": "解释岗位任务、能力、知识、证据和过程关系。",
      "workflow": "explain",
      "input_schema": "schemas/tool-input.schema.json",
      "output_schema": "schemas/workflow-output.schema.json"
    }
  ],
  "skills": [
    {
      "id": "role_capability_graphing",
      "kind": "product_skill",
      "owner": "learning_design_agent",
      "workflows": ["generate", "explain", "iterate", "validate", "upgrade"]
    }
  ],
  "surfaces": [
    {
      "id": "role_capability_project",
      "slot": "project.context.tabs",
      "label": "岗位图谱",
      "definition": "surfaces/project.json"
    }
  ],
  "events": [
    {
      "id": "package_generated",
      "kernel_targets": []
    },
    {
      "id": "snapshot_iterated",
      "kernel_targets": []
    },
    {
      "id": "snapshot_explained",
      "kernel_targets": []
    },
    {
      "id": "release_upgraded",
      "kernel_targets": []
    }
  ],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "max_tasks": {"type": "integer", "minimum": 1, "maximum": 40, "default": 12},
      "include_process_view": {"type": "boolean", "default": true}
    },
    "additionalProperties": false
  },
  "runners": {
    "darwin-arm64": "bin/darwin-arm64/runner",
    "linux-x86_64": "bin/linux-x86_64/runner",
    "linux-arm64": "bin/linux-arm64/runner"
  }
}
