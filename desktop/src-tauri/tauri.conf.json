{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnFlow",
  "version": "0.1.0",
  "identifier": "com.learnflow.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LearnFlow",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/learnflow-backend"
    ]
  }
}
